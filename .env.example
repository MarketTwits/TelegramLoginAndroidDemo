# The only value required for real Telegram authentication.
# The unique identifier of your Telegram bot. Used to verify incoming Telegram ID tokens.
# Must match the bot ID part of the token from BotFather (e.g. 123456789).
TELEGRAM_CLIENT_ID=

# A secret token to protect the API from unauthorized clients.
# Generate a random string and use the exact same value in the Android client's local.properties.
APP_TOKEN=

# Production Compose only: choose a published backend image by full commit tag or digest.
# BACKEND_IMAGE=ghcr.io/markettwits/telegramlogindemo:sha-<40-character-commit-sha>

# Optional list of acceptable tokens for zero-downtime token rotation (comma-separated).
# If specified, any token in this list is accepted. Takes precedence over APP_TOKEN.
# APP_TOKENS=

# Passkey relying party. RP ID is the hostname of the public HTTPS backend.
# Origins are comma-separated, for example android:apk-key-hash:<base64url fingerprint>.
PASSKEY_RP_ID=
PASSKEY_RP_NAME=Telegram Login Demo
PASSKEY_ALLOWED_ORIGINS=
PASSKEY_ANDROID_PACKAGE=com.markettwits.devx.tgsignin
# Comma-separated uppercase colon-delimited signing certificate fingerprints.
PASSKEY_ANDROID_CERT_SHA256=

# Keep false for direct access. Set 1 when exactly one trusted reverse proxy is used.
# TRUST_PROXY=false

# Logging format: "json" for structured machine-readable logs, or "text" for human-friendly development output.
# Defaults to "json" when NODE_ENV=production.
# LOG_FORMAT=json
