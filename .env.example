# The only value required for real Telegram authentication.
# The unique identifier of your Telegram bot. Used to verify incoming Telegram ID tokens.
# Must match the bot ID part of the token from BotFather (e.g. 123456789).
TELEGRAM_CLIENT_ID=

# A secret token to protect the API from unauthorized clients.
# Generate a random string and use the exact same value in the Android client's local.properties.
APP_TOKEN=

# Keep false for direct access. Set 1 when exactly one trusted reverse proxy is used.
# TRUST_PROXY=false
