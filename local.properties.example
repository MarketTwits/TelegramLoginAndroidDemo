# Copy this file to local.properties for a real Telegram integration.
# Android Studio may add sdk.dir automatically.
# All values below are required before Gradle Sync.
telegram.clientId=000000000
# App Link host generated by BotFather for the app's signing certificate.
telegram.redirectHost=app000000001-login.tg.dev
# scripts/run-backend-local.sh forwards this device port to the host through ADB.
telegram.backendUrl=http://127.0.0.1:8080

# GitHub Packages credentials required to resolve the Telegram Login SDK.
gpr.user=YOUR_GITHUB_LOGIN
gpr.key=YOUR_GITHUB_PAT_WITH_READ_PACKAGES
